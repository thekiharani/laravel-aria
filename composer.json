{
  "name": "thekiharani/laravel-aria",
  "description": "The layer between laravel/ai and a product: conversations, retrieval over a pluggable corpus, spend governance, and PII masking.",
  "keywords": ["laravel", "ai", "assistant", "rag", "embeddings"],
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Joseph Gitonga",
      "email": "thekiharani@gmail.com",
      "homepage": "https://github.com/thekiharani"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/console": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "laravel/ai": "^0.11"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.20",
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^3.0|^4.0|^5.0"
  },
  "autoload": {
    "psr-4": {
      "NoriaLabs\\Aria\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NoriaLabs\\Aria\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": ["NoriaLabs\\Aria\\AriaServiceProvider"]
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
